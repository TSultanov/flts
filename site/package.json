{
  "name": "site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage",
    "test:ui": "vitest --ui",
    "test:mutation": "stryker run",
    "test:mutation:watch": "stryker run --watch",
    "test:mutation:incremental": "stryker run --incremental",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:real": "PLAYWRIGHT_REAL=true playwright test -c playwright.real.config.ts",
    "test:e2e:real:ui": "PLAYWRIGHT_REAL=true playwright test -c playwright.real.config.ts --ui",
    "test:e2e:real:debug": "PLAYWRIGHT_REAL=true playwright test -c playwright.real.config.ts --debug"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/jsdom": "^30.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "epubts": "^0.2.0",
    "fake-indexeddb": "^6.2.6",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "jszip": "^3.10.2",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/plugin-barcode-scanner": "~2.5.3",
    "@tauri-apps/plugin-dialog": "~2.8.3",
    "@tauri-apps/plugin-log": "~2.10.1",
    "@tauri-apps/plugin-os": "~2.4.0",
    "@tauri-apps/plugin-window-state": "~2.5.0",
    "dexie": "^4.4.6",
    "qrcode": "^1.5.4",
    "sv-router": "^0.19.0",
    "svelte-fa": "^4.0.4"
  },
  "pnpm": {
    "overrides": {
      "@tauri-apps/api": "~2.12.4"
    }
  }
}
